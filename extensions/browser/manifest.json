{
  "manifest_version": 3,
  "name": "DeepSeek Code Agent Bridge",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "description": "Connects the VS Code agent to an existing DeepSeek web session.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chat.deepseek.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/deepseek.png",
    "48": "icons/deepseek.png",
    "128": "icons/deepseek.png"
  },
  "action": {
    "default_icon": "icons/deepseek.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
